<Project Sdk="Microsoft.NET.Sdk">

  <!-- One source tree, several Jellyfin ABIs. Everything that differs between
       them is a property with a default here, overridden per row by the
       release matrix (.github/workflows/release.yml). Building with no
       overrides gives the primary row, which is what a local build wants. -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
    <!-- Deliberately NOT overridden as TargetFramework: MSBuild strips a global
         TargetFramework before restore, so -p:TargetFramework=net10.0 restores
         the row's packages against net9.0 and NU1202s. A custom property
         survives restore and then sets the real one. -->
    <JellyfinFramework Condition="'$(JellyfinFramework)' == ''">net9.0</JellyfinFramework>
    <TargetFramework>$(JellyfinFramework)</TargetFramework>
    <!-- Tracks the Jellyfin ABI it is built against, kofinsyncqueue convention:
         <server major.minor>.0.<build>. The prefix is what makes a v12 server
         rank the v12 zip above the 10.11 one, since Jellyfin treats targetAbi
         as a floor and will otherwise happily offer the older build
         (jellyfin#11331, closed Not A Bug). -->
    <PluginVersion Condition="'$(PluginVersion)' == ''">10.11.0.8</PluginVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin to the OLDEST supported patch of the row's server line: .NET binds
         an assembly reference upward but never downward, so building against
         10.11.11 produces a plugin that a 10.11.7 server refuses to load
         (verified in the M0 spike). -->
    <PackageReference Include="Jellyfin.Controller" Version="[$(JellyfinVersion)]" />
    <PackageReference Include="Jellyfin.Data" Version="[$(JellyfinVersion)]" />
    <!-- Compile-time only: the server ships Swashbuckle 6.2.3 (Directory.Packages.props
         @ release-10.11.z); shipping our own copy would shadow it in the plugin ALC. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.2.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
