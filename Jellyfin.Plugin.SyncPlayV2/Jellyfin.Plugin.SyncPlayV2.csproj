<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tracks the Jellyfin ABI it is built against, kofinsyncqueue convention. -->
    <AssemblyVersion>12.0.0.2</AssemblyVersion>
    <FileVersion>12.0.0.2</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin to the OLDEST supported 10.11 patch: .NET binds an assembly
         reference upward but never downward, so building against 10.11.11
         produces a plugin that a 10.11.7 server refuses to load (verified in
         the M0 spike). -->
    <PackageReference Include="Jellyfin.Controller" Version="[12.0.0-rc5]" />
    <PackageReference Include="Jellyfin.Data" Version="[12.0.0-rc5]" />
    <!-- Compile-time only: the server ships Swashbuckle 6.2.3 (Directory.Packages.props
         @ release-10.11.z); shipping our own copy would shadow it in the plugin ALC. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.2.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
